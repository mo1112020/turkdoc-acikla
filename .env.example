# Copy this file to .env and fill in your values.
# NEVER commit .env — it is listed in .gitignore.

# Required: Groq API key (https://console.groq.com/)
GROQ_API_KEY=your_api_key_here

# Required in production: generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# development | production
ENVIRONMENT=development

# Comma-separated allowed browser origins (production only).
# Example: https://your-app.example.com,https://www.your-app.example.com
# Leave empty for same-origin deployment (recommended).
CORS_ORIGINS=

# SQLite path (default is fine for local use)
DATABASE_URL=sqlite:///./data/turkdoc.db

# JWT session length in minutes (default: 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Max upload size in megabytes
MAX_UPLOAD_SIZE_MB=10

# Server bind (used by turkdoc-server)
HOST=127.0.0.1
PORT=8000

# Set to false in production
RELOAD=true
